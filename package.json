{
  "name": "fc",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "generate-schema": "npx typescript-json-schema ./src/interface/index.ts IProps --required -o ./src/schema.json",
    "prewatch": "node -e \"const fs=require('fs');fs.mkdirSync('dist',{recursive:true});fs.copyFileSync('src/schema.json','dist/schema.json')\"",
    "prebuild": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.mkdirSync('dist',{recursive:true});fs.copyFileSync('src/schema.json','dist/schema.json')\"",
    "watch": "npx tsc -w -p tsconfig.json",
    "start": "npm run watch",
    "build": "ncc build src/index.ts -m -o dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write src",
    "publish": "npm i && npm run build && s registry publish",
    "lint": "f2elint scan",
    "fix": "f2elint fix",
    "test": "jest --config jestconfig.json __tests__/ut --coverage",
    "test:it": "jest --config jestconfig.json __tests__/it",
    "deadcode": "ts-prune -p tsconfig.json",
    "depcheck": "depcheck"
  },
  "repository": "git@github.com:devsapp/fc3.git",
  "keywords": [],
  "author": "",
  "license": "ISC",
